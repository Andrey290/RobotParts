		<region region-id="188" left="6" top="776.25" width="33.75" height="12" align-x="18.75" align-y="786" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Обычный" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">
					<b>Плечо </b>
				</p>
			</text>
		</region>
		<region region-id="191" left="6" top="794.25" width="451.5" height="48" align-x="15.75" align-y="804" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Обычный" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Если идти с конца плеча, то первым делом нас встречает двигатель привода локтя. Из полученных данных о локте+схвате надо выбрать двигатель.<br/>С учётом его параметров провести расчёты, после чего уточнить требования к нему и пересчитать. То есть выбор двигтаеля производится итерационно.</p>
			</text>
		</region>
		<region region-id="193" left="6" top="854.25" width="107.25" height="12" align-x="18" align-y="864" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Обычный" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Пусть ускорение будет:</p>
			</text>
		</region>
		<region region-id="197" left="126" top="855" width="45" height="12.75" align-x="158.25" align-y="864" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">ε_max</ml:id>
					<ml:real>5</ml:real>
				</ml:define>
			</math>
			<rendering item-idref="27"/>
		</region>
		<region region-id="199" left="198" top="854.25" width="33.75" height="12" align-x="204.75" align-y="864" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Обычный" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">рад/с^2</p>
			</text>
		</region>
		<region region-id="203" left="6" top="872.25" width="454.5" height="24" align-x="12.75" align-y="882" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Обычный" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Его нужно выбирать таким, чтобы оно обеспечивало отработку дифференциальной компоненты регулятора тока.</p>
			</text>
		</region>
		<region region-id="204" left="6" top="897" width="98.25" height="18.75" align-x="42" align-y="912" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">J_cubit</ml:id>
					<ml:apply>
						<ml:mult/>
						<ml:id xml:space="preserve">m_cg</ml:id>
						<ml:apply>
							<ml:pow/>
							<ml:id xml:space="preserve">r_cg</ml:id>
							<ml:real>2</ml:real>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
			<rendering item-idref="28"/>
		</region>
		<region region-id="207" left="294" top="903" width="68.25" height="12.75" align-x="328.5" align-y="912" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">J_cubit</ml:id>
					<result xmlns="http://schemas.mathsoft.com/math30">
						<ml:real>0.55945125000000007</ml:real>
					</result>
				</ml:eval>
			</math>
			<rendering item-idref="29"/>
		</region>
		<region region-id="210" left="378" top="902.25" width="27" height="12" align-x="381.75" align-y="912" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="false">
				<p style="Обычный" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">кг*м:2</p>
			</text>
		</region>
		<region region-id="213" left="6" top="927" width="228" height="12.75" align-x="75.75" align-y="936" show-border="false" show-highlight="false" is-protected="true" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
